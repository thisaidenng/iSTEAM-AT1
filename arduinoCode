#include <LiquidCrystal_I2C.h>
#include <SoftwareSerial.h>
#include <wire.h>

// ── Pins ─────────────────────────────────────────────────────────
const int BT_RX      = 2;
const int BT_TX      = 4;
const int BUTTON_PIN = 3;

// ── Limits ───────────────────────────────────────────────────────
const int MAX_DEVICES = 12;

// ── Hardware ─────────────────────────────────────────────────────
SoftwareSerial    btSerial(BT_RX, BT_TX);
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ── Device table ─────────────────────────────────────────────────
struct Device {
  char          mac[18];
  unsigned long lastSeen;
};
Device devices[MAX_DEVICES];
int    deviceCount = 0;

// ── Scan buffers ─────────────────────────────────────────────────
char scanMACs[MAX_DEVICES][18];
int  scanCount = 0;

char prevMACs[MAX_DEVICES][18];
int  prevCount = 0;

// ── Scan state ───────────────────────────────────────────────────
int           rawFound    = 0;
int           uniqueFound = 0;
bool          scanning    = false;
unsigned long scanStart   = 0;
unsigned long scanEnd     = 0;
unsigned long scanDuration = 8000UL;
unsigned long scanPause    = 2000UL;

// ── Buffers ───────────────────────────────────────────────────────
char lineBuf[24];
int  lineLen = 0;
char cmdBuf[16];
int  cmdLen  = 0;

// ── LCD ──────────────────────────────────────────────────────────
volatile bool buttonPressed = false;
unsigned long lastBounce    = 0;
int           currentScreen = 0;

// ════════════════════════════════════════════════════════════════
// ISR
// ════════════════════════════════════════════════════════════════
void buttonISR() {
  unsigned long now = millis();
  if (now - lastBounce > 400) {
    buttonPressed = true;
    lastBounce    = now;
  }
}

// ════════════════════════════════════════════════════════════════
// MAC helpers
// ════════════════════════════════════════════════════════════════
bool parseMAC(const char* input, char* output) {
  if (input[0] != '0' || input[1] != 'x') return false;
  const char* hex = input + 2;
  for (int i = 0; i < 12; i++) {
    char c = hex[i];
    bool ok = (c >= '0' && c <= '9') ||
              (c >= 'A' && c <= 'F') ||
              (c >= 'a' && c <= 'f');
    if (!ok) return false;
  }
  int o = 0;
  for (int i = 0; i < 12; i += 2) {
    output[o++] = hex[i];
    output[o++] = hex[i + 1];
    if (i < 10) output[o++] = ':';
  }
  output[o] = '\0';
  return true;
}

bool macEqual(const char* a, const char* b) {
  for (int i = 0; i < 17; i++) if (a[i] != b[i]) return false;
  return true;
}

void macCopy(char* dst, const char* src) {
  for (int i = 0; i < 18; i++) dst[i] = src[i];
}

bool macInScan(const char* mac) {
  for (int i = 0; i < scanCount; i++) {
    if (macEqual(scanMACs[i], mac)) return true;
  }
  return false;
}

bool macInPrev(const char* mac) {
  for (int i = 0; i < prevCount; i++) {
    if (macEqual(prevMACs[i], mac)) return true;
  }
  return false;
}

// ════════════════════════════════════════════════════════════════
// Device table
// ════════════════════════════════════════════════════════════════
int findDevice(const char* mac) {
  for (int i = 0; i < deviceCount; i++) {
    if (macEqual(devices[i].mac, mac)) return i;
  }
  return -1;
}

void removeDevice(int slot) {
  Serial.print(F("[LEFT] "));
  Serial.println(devices[slot].mac);
  for (int j = slot; j < deviceCount - 1; j++) {
    macCopy(devices[j].mac, devices[j+1].mac);
    devices[j].lastSeen = devices[j+1].lastSeen;
  }
  deviceCount--;
}

int estimatedPeople() {
  return deviceCount;
}

// ════════════════════════════════════════════════════════════════
// Randomisation logic
//
// Rule: compare this scan to the previous scan.
//
//   GONE     = MACs in prev scan that are missing from this scan
//   APPEARED = MACs in this scan that were not in prev scan
//
//   pairs = min(gone, appeared)
//
//   For each pair:
//     One disappearance + one appearance = same device, new MAC
//     → update the slot in place, count unchanged
//
//   Unpaired appearances = new people arrived → add to table
//   Unpaired disappearances = people left     → remove from table
// ════════════════════════════════════════════════════════════════
void resolveDevices() {
  unsigned long now = millis();

  // Build gone[] — in prev but not in current scan
  char gone[MAX_DEVICES][18];
  int  goneCount = 0;
  for (int p = 0; p < prevCount; p++) {
    if (!macInScan(prevMACs[p])) {
      macCopy(gone[goneCount++], prevMACs[p]);
    }
  }

  // Build appeared[] — in current scan but not in prev
  char appeared[MAX_DEVICES][18];
  int  appearedCount = 0;
  for (int s = 0; s < scanCount; s++) {
    if (!macInPrev(scanMACs[s])) {
      macCopy(appeared[appearedCount++], scanMACs[s]);
    }
  }

  Serial.print(F("[RAND] Gone="));
  Serial.print(goneCount);
  Serial.print(F(" Appeared="));
  Serial.println(appearedCount);

  // Pair disappearances with appearances
  int pairs = goneCount < appearedCount ? goneCount : appearedCount;

  for (int i = 0; i < pairs; i++) {
    int slot = findDevice(gone[i]);
    if (slot >= 0) {
      Serial.print(F("[RAND] "));
      Serial.print(devices[slot].mac);
      Serial.print(F(" -> "));
      Serial.println(appeared[i]);
      macCopy(devices[slot].mac, appeared[i]);
      devices[slot].lastSeen = now;
    }
  }

  // Unpaired appearances = new people
  for (int i = pairs; i < appearedCount; i++) {
    if (deviceCount >= MAX_DEVICES) {
      Serial.println(F("[TRACK] full"));
      continue;
    }
    macCopy(devices[deviceCount].mac, appeared[i]);
    devices[deviceCount].lastSeen = now;
    deviceCount++;
    Serial.print(F("[NEW] "));
    Serial.println(appeared[i]);
  }

  // Unpaired disappearances = people left
  for (int i = pairs; i < goneCount; i++) {
    int slot = findDevice(gone[i]);
    if (slot >= 0) removeDevice(slot);
  }

  // Refresh lastSeen for MACs that stayed
  for (int s = 0; s < scanCount; s++) {
    int slot = findDevice(scanMACs[s]);
    if (slot >= 0) devices[slot].lastSeen = now;
  }

  uniqueFound = scanCount;

  // Save this scan as previous
  prevCount = scanCount;
  for (int i = 0; i < scanCount; i++) macCopy(prevMACs[i], scanMACs[i]);
}

// ════════════════════════════════════════════════════════════════
// LCD
// ════════════════════════════════════════════════════════════════
void updateLCD() {
  lcd.clear();
  switch (currentScreen) {
    case 0:
      lcd.setCursor(0, 0); lcd.print(F("Unique Found"));
      lcd.setCursor(0, 1); lcd.print(F("> ")); lcd.print(uniqueFound);
      break;
    case 1:
      lcd.setCursor(0, 0); lcd.print(F("Est. People"));
      lcd.setCursor(0, 1); lcd.print(F("> ")); lcd.print(estimatedPeople());
      break;
  }
}
// ════════════════════════════════════════════════════════════════
// Scan
// ════════════════════════════════════════════════════════════════
void startScan() {
  rawFound  = 0;
  scanCount = 0;
  scanStart = millis();
  scanning  = true;
  btSerial.println("AT+INQ");
  Serial.println(F("[SCAN] Started"));
  updateLCD();
}

void endScan() {
  scanning = false;
  scanEnd  = millis();

  resolveDevices();

  Serial.print(F("[SCAN] Done  Raw="));
  Serial.print(rawFound);
  Serial.print(F("  Unique="));
  Serial.print(uniqueFound);
  Serial.print(F("  Est="));
  Serial.println(estimatedPeople());

  updateLCD();
}

void processINQLine(const char* line) {
  const char* p = line;
  while (*p) {
    if (*p == ' ' && *(p+1) == '0' && *(p+2) == 'x') break;
    p++;
  }
  if (!*p) return;

  char mac[18];
  if (!parseMAC(p + 1, mac)) return;

  rawFound++;

  if (macInScan(mac)) return;
  if (scanCount < MAX_DEVICES) {
    macCopy(scanMACs[scanCount++], mac);
    Serial.print(F("[INQ] "));
    Serial.println(mac);
  }
}

// ════════════════════════════════════════════════════════════════
// Serial commands
// ════════════════════════════════════════════════════════════════
void handleCommand(const char* cmd) {
  if (cmd[0]=='S' && cmd[1]=='C' && cmd[2]=='A' && cmd[3]=='N' && cmd[4]==':') {
    int v = 0;
    for (int i = 5; cmd[i] >= '0' && cmd[i] <= '9'; i++) v = v*10 + (cmd[i]-'0');
    if (v > 0 && v < 60) scanDuration = (unsigned long)v * 1000;
    return;
  }
  if (cmd[0]=='W' && cmd[1]=='A' && cmd[2]=='I' && cmd[3]=='T' && cmd[4]==':') {
    int v = 0;
    for (int i = 5; cmd[i] >= '0' && cmd[i] <= '9'; i++) v = v*10 + (cmd[i]-'0');
    if (v > 0 && v < 60) scanPause = (unsigned long)v * 1000;
    return;
  }
  if (cmd[0]=='S' && cmd[1]=='T' && cmd[2]=='A' && cmd[3]=='T') {
    Serial.print(F("est="));     Serial.println(estimatedPeople());
    Serial.print(F("unique="));  Serial.println(uniqueFound);
    Serial.print(F("devices=")); Serial.println(deviceCount);
    for (int i = 0; i < deviceCount; i++) {
      Serial.print(i); Serial.print(' ');
      Serial.println(devices[i].mac);
    }
  }
}

// ════════════════════════════════════════════════════════════════
// Setup
// ════════════════════════════════════════════════════════════════
void setup() {
  Serial.begin(9600);
  btSerial.begin(9600);
  Wire.begin();

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print(F("Init BT..."));

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(BUTTON_PIN), buttonISR, FALLING);

  btSerial.println("AT");       delay(500);
  btSerial.println("AT+ROLE1"); delay(500);
  btSerial.println("AT+RESET"); delay(1000);

  while (btSerial.available()) btSerial.read();
  lineLen = 0;
  cmdLen  = 0;

  Serial.println(F("Ready. Commands: SCAN:N  WAIT:N  STATUS"));
  startScan();
}

// ════════════════════════════════════════════════════════════════
// Loop
// ════════════════════════════════════════════════════════════════
void loop() {

  // ── Button ──────────────────────────────────────────────────
  if (buttonPressed) {
    buttonPressed = false;
    currentScreen = (currentScreen + 1) % 2;
    updateLCD();
  }

  // ── BT serial ───────────────────────────────────────────────
  while (btSerial.available()) {
    char c = btSerial.read();
    if (c == '\r') continue;
    if (c == '\n' || lineLen >= 46) {
      lineBuf[lineLen] = '\0';
      lineLen = 0;
      if (lineBuf[0] != '\0') {
        Serial.print(F("[BT] "));
        Serial.println(lineBuf);
      }
      if (lineBuf[0]=='+' && lineBuf[1]=='I' &&
          lineBuf[2]=='N' && lineBuf[3]=='Q' &&
          lineBuf[4]==':' && scanning) {
        processINQLine(lineBuf);
      }
    } else {
      lineBuf[lineLen++] = c;

      // Split +INQS appearing mid-line
      if (lineLen >= 5 &&
          lineBuf[lineLen-5]=='+' && lineBuf[lineLen-4]=='I' &&
          lineBuf[lineLen-3]=='N' && lineBuf[lineLen-2]=='Q' &&
          lineBuf[lineLen-1]=='S') {
        lineBuf[lineLen-5] = '\0';
        if (lineBuf[0] != '\0') {
          Serial.print(F("[BT] "));
          Serial.println(lineBuf);
          if (lineBuf[0]=='+' && lineBuf[1]=='I' &&
              lineBuf[2]=='N' && lineBuf[3]=='Q' &&
              lineBuf[4]==':' && scanning) {
            processINQLine(lineBuf);
          }
        }
        lineLen = 0;
      }
    }
  }

  // ── Scan timeout ─────────────────────────────────────────────
  if (scanning && (millis() - scanStart) > scanDuration) {
    endScan();
  }

  // ── Pause then restart ───────────────────────────────────────
  if (!scanning && (millis() - scanEnd) > scanPause) {
    startScan();
  }

  // ── PC serial commands ───────────────────────────────────────
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\r') continue;
    if (c == '\n' || cmdLen >= 14) {
      cmdBuf[cmdLen] = '\0';
      cmdLen = 0;
      if (cmdBuf[0] != '\0') handleCommand(cmdBuf);
    } else {
      cmdBuf[cmdLen++] = c;
    }
  }
}
